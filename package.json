{
  "name": "myeca-in",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.16.0"
  },
  "scripts": {
    "dev": "set NODE_ENV=development&& npx tsx server/index.ts",
    "build": "tsx scripts/build-production.ts",
    "build:android": "set VITE_API_BASE_URL=https://myeca.in&& npm run build",
    "start": "set NODE_ENV=production&& tsx server/index.ts",
    "check": "tsc",
    "check:db": "tsx scripts/check-db-readiness.ts",
    "test:unit": "vitest run",
    "test:design-system": "vitest run client/src/lib/design-system-token-contract.test.ts client/src/components/ui/button.test.tsx client/src/components/ui/card.test.tsx",
    "test:smoke": "tsx scripts/smoke-routes.ts",
    "audit:public-links": "tsx scripts/audit-public-links.ts",
    "test:cloudflare-pages": "npm run build && tsx scripts/check-cloudflare-pages.ts",
    "test:e2e": "npm.cmd run build && playwright test",
    "check:env": "tsx scripts/check-env.ts",
    "check:static-seo": "tsx scripts/validate-static-seo.ts",
    "check:seo-metadata": "tsx scripts/audit-seo-metadata.ts",
    "check:content-quality": "tsx scripts/check-content-quality.ts",
    "check:content-quality:drafts": "tsx scripts/check-content-quality.ts --drafts",
    "check:content-quality:strict": "tsx scripts/check-content-quality.ts --strict --built",
    "optimize:public-assets": "tsx scripts/optimize-public-assets.ts",
    "report:content-review": "tsx scripts/generate-public-content-review-queue.ts",
    "rewrite:structured-copy": "tsx scripts/rewrite-repeated-structured-copy.ts",
    "rewrite:transition-workflows": "tsx scripts/rewrite-transition-workflows.ts",
