    "rewrite:ay-persona-guides": "tsx scripts/rewrite-ay-persona-guides.ts",
    "rewrite:thin-published-guides": "tsx scripts/deepen-thin-published-guides.ts",
    "rewrite:near-duplicate-guides": "tsx scripts/deepen-near-duplicate-guides.ts",
    "check:content-review-queue": "tsx scripts/generate-public-content-review-queue.ts --check",
    "check:typography": "tsx scripts/check-typography.ts",
    "check:built-semantic-colors": "tsx scripts/check-built-semantic-colors.ts",
    "check:design-classes": "tsx scripts/check-design-class-usage.ts",
    "check:design-system": "npm.cmd run test:design-system && npm.cmd run check:design-classes && npm.cmd run build",
    "check:dead-code": "ts-prune | grep -v '(used in module)' | tee dead-code-report.txt | wc -l && echo 'unused exports — see dead-code-report.txt for the list'",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:generate:preview": "dotenv -e .env -e .vercel/.env.preview.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "db:migrate:preview": "dotenv -e .env -e .vercel/.env.preview.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env -- drizzle-kit push",
    "db:push:preview": "dotenv -e .env -e .vercel/.env.preview.local -- drizzle-kit push",
    "db:seed": "dotenv -e .env -- tsx server/scripts/seed.ts",
    "db:seed:demo": "dotenv -e .env -- tsx server/scripts/seed-demo-workspace.ts",
    "db:seed:demo:cleanup": "dotenv -e .env -- tsx server/scripts/seed-demo-workspace.ts --cleanup",
    "db:seed:preview": "dotenv -e .env -e .vercel/.env.preview.local -- tsx server/scripts/seed.ts",
    "db:reset-zero-test": "dotenv -e .env -- tsx server/scripts/reset-zero-test-data.ts",
    "db:reset-zero-test:preview": "dotenv -e .env -e .vercel/.env.preview.local -- tsx server/scripts/reset-zero-test-data.ts",
    "seed:blogs": "dotenv -e .env -- tsx server/scripts/seed-blogs.ts",
    "seed:tax-blogs": "dotenv -e .env -- tsx server/scripts/seed-tax-blogs.ts",
    "generate:blog-covers": "dotenv -e .env -- tsx server/scripts/generate-blog-text-covers.ts --apply",
    "generate:blog-gpt-covers": "dotenv -e .env -- tsx server/scripts/generate-blog-gpt-image-covers.ts",
    "sync:income-tax-forms": "tsx scripts/sync-income-tax-forms.ts",
    "upload:pdf-assets": "tsx scripts/upload-income-tax-form-pdfs.ts",
    "check:size": "tsx scripts/check-size-budget.ts",
    "check:google-indexing": "tsx scripts/check-google-indexing-readiness.ts",
    "check:google-indexing-evidence": "tsx scripts/check-google-indexing-evidence-log.ts",
    "check:search-engines": "tsx scripts/check-search-engines.ts",
    "check:spa-fallback-indexing": "tsx scripts/check-spa-fallback-indexing.ts",
    "check:itr-season-seo-content": "tsx scripts/check-itr-season-seo-content.ts",
    "check:priority-structured-data": "tsx scripts/check-priority-structured-data.ts",
    "check:priority-seo-sweep": "tsx scripts/check-priority-seo-sweep.ts",
    "check:seo-deployment-parity": "tsx scripts/check-seo-deployment-parity.ts",
    "check:search-goal-readiness": "tsx scripts/check-search-goal-readiness.ts",
    "check:seo-outreach-readiness": "tsx scripts/check-seo-outreach-readiness.ts",
    "check:bing-indexing-evidence": "tsx scripts/check-bing-indexing-evidence-log.ts",
    "check:core-web-vitals": "tsx scripts/check-core-web-vitals.ts",
    "benchmark:module-preload": "tsx scripts/benchmark-module-preload.ts",
    "check:indexnow-key": "tsx scripts/check-indexnow-key.ts",
    "indexnow:submit": "tsx scripts/indexnow-submit.ts",
    "analyze": "set NODE_ENV=production&& set ANALYZE_BUNDLE=1&& vite build",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "vercel:build": "vercel build",
    "generate:sitemap": "tsx server/scripts/generate-sitemap.ts",
    "import:genius-source-catalog": "tsx scripts/import-genius-source-catalog.ts",
    "review:genius-readable-forms": "npm --prefix tools/genius-readable-review run review"
  },
