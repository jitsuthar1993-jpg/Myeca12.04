# MyeCA.in Environment Variables
# Copy this file to .env for local development and add the same values in Vercel.

# App
NODE_ENV=development
APP_URL=http://localhost:5000
VITE_APP_URL=http://localhost:5000
HOST=127.0.0.1
PORT=5000
ALLOWED_ORIGINS=

# Supabase authentication
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_GOOGLE_AUTH=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres
DATABASE_URL=
# Optional: paste the Supabase CA certificate (Settings -> Database -> SSL) to enable full
# TLS verification of the database connection in production. When unset, the connection is
# still encrypted but the server certificate is not verified.
DATABASE_CA_CERT=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Role bootstrap
# Comma-separated email addresses that should be assigned admin on auth sync.
ADMIN_EMAILS=
TEAM_MEMBER_EMAILS=

# Built-in temporary test users (admin/CA/team/user shortcut tokens) are honored ONLY when
# NODE_ENV=development, or when this is explicitly set to "true". Never set this in production.
ALLOW_TEMPORARY_TEST_USERS=

# Security
SESSION_SECRET=
PII_ENCRYPTION_KEY=
BLOG_IMPORT_SECRET=
SECURITY_LEAD_PHONE=
SECURITY_ADMIN_PHONE=
SECURITY_BACKUP_PHONE=
SECURITY_EXTERNAL_NAME=
SECURITY_EXTERNAL_ORGANIZATION=
SECURITY_EXTERNAL_CONTACT=

# Email services
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI features
OPENAI_API_KEY=

# WhatsApp Blog Publisher (Twilio)
# Sign up at https://console.twilio.com -> Messaging -> Try it out -> Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox number (default) or your purchased WhatsApp Business number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Webhook URL to configure in Twilio console:
#   https://myeca.in/api/whatsapp/webhook  (production)
#   https://<ngrok-url>/api/whatsapp/webhook  (local dev)

# Analytics
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_CLIENT_EMAIL=
GOOGLE_ANALYTICS_PRIVATE_KEY=
# IndexNow key for Bing and participating search engines. Use 8-128 letters, numbers, or dashes.
INDEXNOW_KEY=
VITE_CLARITY_PROJECT_ID=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_CRISP_WEBSITE_ID=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=https://analytics.myeca.in/script.js
VITE_CHATWOOT_BASE_URL=https://chat.myeca.in
VITE_CHATWOOT_WEBSITE_TOKEN=

# Self-hosted automation
LEAD_AUTOMATION_WEBHOOK_URL=
LEAD_AUTOMATION_WEBHOOK_SECRET=
