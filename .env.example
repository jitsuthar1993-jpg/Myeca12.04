# MyeCA.in Environment Variables
# Copy this file to .env for local development and add the same values in Vercel.

# App
NODE_ENV=development
APP_URL=http://localhost:5000
VITE_APP_URL=http://localhost:5000

# Supabase authentication
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_GOOGLE_AUTH=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres
DATABASE_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Role bootstrap
# Comma-separated email addresses that should be assigned admin on auth sync.
ADMIN_EMAILS=
TEAM_MEMBER_EMAILS=

# Security
SESSION_SECRET=
PII_ENCRYPTION_KEY=
BLOG_IMPORT_SECRET=
SECURITY_LEAD_PHONE=
SECURITY_ADMIN_PHONE=
SECURITY_BACKUP_PHONE=
SECURITY_EXTERNAL_NAME=
SECURITY_EXTERNAL_ORGANIZATION=
SECURITY_EXTERNAL_CONTACT=

# Email services
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI features
OPENAI_API_KEY=

# WhatsApp Blog Publisher (Twilio)
# Sign up at https://console.twilio.com -> Messaging -> Try it out -> Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox number (default) or your purchased WhatsApp Business number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Webhook URL to configure in Twilio console:
#   https://myeca.in/api/whatsapp/webhook  (production)
#   https://<ngrok-url>/api/whatsapp/webhook  (local dev)

# Analytics
VITE_GA_MEASUREMENT_ID=
