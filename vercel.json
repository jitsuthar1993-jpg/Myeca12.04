{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/public/index.html",
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/blog/text-covers/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app-bootstrap.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://www.clarity.ms https://scripts.clarity.ms https://*.posthog.com https://*.i.posthog.com https://client.crisp.chat https://analytics.myeca.in https://chat.myeca.in https://va.vercel-scripts.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com https://client.crisp.chat https://chat.myeca.in; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://www.google.com https://analytics.google.com https://*.clarity.ms https://*.posthog.com https://*.i.posthog.com https://*.ingest.sentry.io https://*.sentry.io https://client.crisp.chat https://client.relay.crisp.chat https://analytics.myeca.in https://chat.myeca.in https://api.supabase.io https://*.supabase.co https://vitals.vercel-insights.com https://va.vercel-scripts.com wss://client.relay.crisp.chat wss://*.supabase.co; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://client.crisp.chat https://chat.myeca.in data:; object-src 'none'; media-src 'self'; frame-src 'self' https://www.google.com https://www.googletagmanager.com https://client.crisp.chat https://chat.myeca.in; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/account(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/auth(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/dashboard(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/business/dashboard(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/ca",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/ca/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/documents(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/itr/filing(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/login",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/logout",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/payments(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/profile(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/reports(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/settings(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/user(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/login",
      "destination": "/auth/login",
      "permanent": true
    },
    {
      "source": "/register",
      "destination": "/auth/register",
      "permanent": true
    },
    {
      "source": "/salary",
      "destination": "/services/itr-for-salaried",
      "permanent": true
    },
    {
      "source": "/itr/start",
      "destination": "/which-itr-form-to-file",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.myeca.in" }],
      "destination": "https://myeca.in/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "/api/index?route=health" },
    { "source": "/api/user/dashboard", "destination": "/api/index?route=user-dashboard" },
    { "source": "/api/user/activity", "destination": "/api/index?route=user-activity" },
    { "source": "/api/user-services", "destination": "/api/index?route=user-services" },
    { "source": "/api/notifications", "destination": "/api/index?route=notifications" },
    { "source": "/api/admin/stats", "destination": "/api/index?route=admin-stats" },
    { "source": "/api/admin/users", "destination": "/api/index?route=admin-users" },
    { "source": "/api/admin/services", "destination": "/api/index?route=admin-services" },
    { "source": "/api/admin/user-services", "destination": "/api/index?route=admin-user-services" },
    { "source": "/api/admin/user-services/:id", "destination": "/api/index?route=admin-user-service-detail&id=:id" },
    { "source": "/api/ca/stats", "destination": "/api/index?route=ca-stats" },
    { "source": "/api/ca/clients", "destination": "/api/index?route=ca-clients" },
    { "source": "/api/cms/posts", "destination": "/api/index?route=cms-posts" },
    { "source": "/api/cms/categories", "destination": "/api/index?route=cms-categories" },
    { "source": "/api/documents", "destination": "/api/index?route=documents-list" },
    { "source": "/api/documents/upload", "destination": "/api/index?route=documents-upload" },
    { "source": "/api/documents/stats/summary", "destination": "/api/index?route=documents-summary" },
    { "source": "/api/documents/:id/download", "destination": "/api/index?route=documents-download&id=:id" },
    { "source": "/api/documents/:id", "destination": "/api/index?route=documents-detail&id=:id" },
    { "source": "/api/tax-returns", "destination": "/api/index?route=tax-returns" },
    { "source": "/api/tax-returns/:id/documents", "destination": "/api/index?route=tax-return-documents&id=:id" },
    { "source": "/api/tax-returns/:id/recommendation", "destination": "/api/index?route=tax-return-recommendation&id=:id" },
    { "source": "/api/tax-returns/:id/submit-review", "destination": "/api/index?route=tax-return-submit-review&id=:id" },
    { "source": "/api/tax-returns/:id/review-status", "destination": "/api/index?route=tax-return-review-status&id=:id" },
    { "source": "/api/tax-returns/:id/review-packet", "destination": "/api/index?route=tax-return-review-packet&id=:id" },
    { "source": "/api/tax-returns/:id/export-json", "destination": "/api/index?route=tax-return-export-json&id=:id" },
    { "source": "/api/tax-returns/:id", "destination": "/api/index?route=tax-return-detail&id=:id" },
    { "source": "/api/public/categories", "destination": "/api/index?route=public-categories" },
    { "source": "/api/public/blogs", "destination": "/api/index?route=public-blogs" },
    { "source": "/api/public/blogs/:slug", "destination": "/api/index?route=public-blog&slug=:slug" },
    { "source": "/downloads/income-tax-forms/:slug", "destination": "/api/index?route=income-tax-form-download&slug=:slug" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/sitemap.xml", "destination": "/api/index?route=sitemap" },
    { "source": "/robots.txt", "destination": "/api/index?route=robots" },
    { "source": "/openapi.json", "destination": "/api/index?route=openapi" },
    { "source": "/llms.txt", "destination": "/api/index?route=llms" },
    { "source": "/llms-full.txt", "destination": "/api/index?route=llms-full" },
    { "source": "/:indexNowKey.txt", "destination": "/api/index?route=indexnow-key&key=:indexNowKey" },
    { "source": "/:path*/", "destination": "/api/index?route=app-fallback&path=/:path*" },
    { "source": "/:path*", "destination": "/api/index?route=app-fallback&path=/:path*" }
  ]
}
