TRAEFIK_ACME_EMAIL=admin@myeca.in

POSTGRES_PASSWORD=replace-with-strong-postgres-password
REDIS_PASSWORD=replace-with-strong-redis-password

UMAMI_IMAGE=docker.umami.is/umami-software/umami:postgresql-v3.0.0
UMAMI_APP_SECRET=replace-with-openssl-rand-hex-64
UMAMI_DATABASE_URL=postgresql://umami:replace-with-strong-postgres-password@umami-db:5432/umami

LISTMONK_IMAGE=listmonk/listmonk:v4.1.0
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=replace-with-strong-listmonk-password
LISTMONK_DB_PASSWORD=replace-with-strong-listmonk-db-password
LISTMONK_SMTP_HOST=smtp.brevo.com
LISTMONK_SMTP_PORT=587
LISTMONK_SMTP_USER=
LISTMONK_SMTP_PASSWORD=

CHATWOOT_IMAGE=chatwoot/chatwoot:v4.10.1
CHATWOOT_SECRET_KEY_BASE=replace-with-openssl-rand-hex-64
CHATWOOT_FRONTEND_URL=https://chat.myeca.in
CHATWOOT_POSTGRES_PASSWORD=replace-with-strong-chatwoot-db-password
CHATWOOT_REDIS_URL=redis://:replace-with-strong-redis-password@chatwoot-redis:6379
CHATWOOT_SMTP_ADDRESS=smtp.brevo.com
CHATWOOT_SMTP_PORT=587
CHATWOOT_SMTP_USERNAME=
CHATWOOT_SMTP_PASSWORD=
CHATWOOT_MAILER_SENDER_EMAIL=support@myeca.in

N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.21.5
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-64
N8N_USER=admin
N8N_PASSWORD=replace-with-strong-n8n-password

DOCUSEAL_IMAGE=docuseal/docuseal:2.3.1
DOCUSEAL_SECRET_KEY_BASE=replace-with-openssl-rand-hex-64
DOCUSEAL_DATABASE_URL=postgresql://docuseal:replace-with-strong-docuseal-db-password@docuseal-db:5432/docuseal
DOCUSEAL_DB_PASSWORD=replace-with-strong-docuseal-db-password

TWENTY_IMAGE=twentycrm/twenty:v0.53
TWENTY_SERVER_URL=https://crm.myeca.in
TWENTY_APP_SECRET=replace-with-openssl-rand-base64-32
TWENTY_POSTGRES_PASSWORD=replace-with-strong-twenty-db-password
TWENTY_REDIS_URL=redis://twenty-redis:6379
